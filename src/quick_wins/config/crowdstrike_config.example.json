// This is an example of the structure which is used as the crowdstrike_config.json
// At least ONE alias is needed per unit, since it is used in the Regex matching
// At least ONE email address is needed to send the mail automatically, it will NOT raise an error, but the mail will bounce
{
  "LBH-Belgium": {
    "aliases": ["LBH Belgium", "LBH Antwerp", "LBHBelgium"],
    "domains": [".be"],
    "emails": [{"email": "test@lbh-group-belgium.be", "name": "Test Persoon"}],
    "abbreviation": "BE"
  },
  "LBH-Brazil": {
    "aliases": ["LBH Brazil", "LBH BR"],
    "domains": [".br"],
    "emails": [
      {"email": "test@lbh-group-brasil.com.br", "name": "Pessoa de teste"}, 
      {"email": "test2@lbh-group-brasil.br", "name": "Pessoa de teste 2"}
    ],
    "abbreviation": "BR"
  },
  "LBH-Canada": {
    "aliases": ["LBH Canada"],
    "domains": [],
    "emails": [{"email": "test@lbh-group-canada.com", "name": "Test Person"}],
    "abbreviation": "CA"
  }
}